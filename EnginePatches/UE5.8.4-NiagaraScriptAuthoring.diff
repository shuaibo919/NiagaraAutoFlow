+
+/** A typed Custom HLSL pin and its parameter-map binding. */
+USTRUCT(BlueprintType)
+struct NIAGARAEDITOR_API FNiagaraModuleAuthoringPin
+{
+	GENERATED_BODY()
+
+	/** Unique HLSL identifier, e.g. InVelocity or OutVelocity. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Authoring")
+	FString Name;
+
+	/** float, float2, float3, float4, int, bool, color or position. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Authoring")
+	FString Type = TEXT("float");
+
+	/** Inputs: Module.*, Particles.*, Emitter.*, System.*, User.* or Engine.*. Outputs: writable scope attribute. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Authoring")
+	FString Variable;
+
+	/** Niagara pin-default syntax; inputs only. Empty uses the type's default. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Authoring")
+	FString DefaultValue;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Authoring")
+	FString Description;
+};
+
+/** Complete definition of a managed, single Custom HLSL module graph. */
+USTRUCT(BlueprintType)
+struct NIAGARAEDITOR_API FNiagaraModuleAuthoringDefinition
+{
+	GENERATED_BODY()
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Authoring")
+	TArray<FNiagaraModuleAuthoringPin> Inputs;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Authoring")
+	TArray<FNiagaraModuleAuthoringPin> Outputs;
+
+	/** Function body assigning every named output; not a single-rvalue expression. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Authoring")
+	FString Hlsl;
+
+	/** Standard System/Emitter/Particle Spawn/Update usages. All usages must share a writable scope. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Authoring")
+	TArray<ENiagaraScriptUsage> AllowedUsages;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Authoring")
+	FString Description;
+};
+
+/** Editor-only bridge. No tool registry dependency. Does not compile or save packages. */
+class NIAGARAEDITOR_API FNiagaraScriptAuthoringUtilities
+{
+public:
+	/** Validate arguments without changing assets. Does not validate HLSL compilation. */
+	static bool ValidateDefinition(const FNiagaraModuleAuthoringDefinition& Definition, FString& OutError);
+	/** Outer must be a package. Existing objects are never overwritten. */
+	static UNiagaraScript* CreateModuleScript(UObject* Outer, FName Name, const FNiagaraModuleAuthoringDefinition& Definition, FString& OutError);
+	/** Refuses unmanaged graphs, versioned scripts and graphs edited since authoring. */
+	static bool GetModuleDefinition(UNiagaraScript* Script, FNiagaraModuleAuthoringDefinition& OutDefinition, FString& OutError);
+	/** Builds a replacement source before changing the live script. Caller owns compile/rollback/save policy. */
+	static bool UpdateModuleDefinition(UNiagaraScript* Script, const FNiagaraModuleAuthoringDefinition& Definition, FString& OutError);
+
+    /** Typed DI module/stage bridge. Does not compile or save; callers validate GPU contexts. */
+    static UNiagaraScript* CreateDataInterfaceModuleScript(const FString& DefinitionJson, FString& OutError);
+    static bool UpdateDataInterfaceModuleHlsl(UNiagaraScript* Module, const FString& Hlsl, FString& OutError);
+    /** Add scalar/vector User inputs to an existing generated DI module; no compile or save. */
+    static bool AddDataInterfaceModuleInputs(UNiagaraScript* Module, const FString& InputsJson, FString& OutError);
+    static bool AddDataInterfaceSimulationStage(UNiagaraEmitter* Emitter, const FGuid& Version,
+        UNiagaraScript* Module, FName StageName, const FNiagaraVariable& IterationInterface, FString& OutError);
+};
