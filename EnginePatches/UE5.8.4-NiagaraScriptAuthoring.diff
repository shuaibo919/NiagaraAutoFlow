+namespace NiagaraScriptAuthoring
+{
+	static const TCHAR* DefinitionKey = TEXT("NiagaraModuleAuthoring.Definition.v1");
+	static const TCHAR* GraphIdKey = TEXT("NiagaraModuleAuthoring.Fingerprint.v1");
+
+	static bool Fail(FString& Error, const FString& Message)
+	{
+		Error = Message;
+		return false;
+	}
+
+	static bool Identifier(const FString& Name)
+	{
+		if (Name.IsEmpty() || !(FChar::IsAlpha(Name[0]) && Name[0] < 128)) { return false; }
+		for (TCHAR Char : Name)
+		{
+			if (Char >= 128 || !(FChar::IsAlnum(Char) || Char == TEXT('_'))) { return false; }
+		}
+		return true;
+	}
+
+	static bool ResolveType(const FString& Name, FNiagaraTypeDefinition& Type)
+	{
+		if (Name == TEXT("float")) { Type = FNiagaraTypeDefinition::GetFloatDef(); }
+		else if (Name == TEXT("float2")) { Type = FNiagaraTypeDefinition::GetVec2Def(); }
+		else if (Name == TEXT("float3")) { Type = FNiagaraTypeDefinition::GetVec3Def(); }
+		else if (Name == TEXT("float4")) { Type = FNiagaraTypeDefinition::GetVec4Def(); }
+		else if (Name == TEXT("quat")) { Type = FNiagaraTypeDefinition::GetQuatDef(); }
+		else if (Name == TEXT("int")) { Type = FNiagaraTypeDefinition::GetIntDef(); }
+		else if (Name == TEXT("bool")) { Type = FNiagaraTypeDefinition::GetBoolDef(); }
+		else if (Name == TEXT("color")) { Type = FNiagaraTypeDefinition::GetColorDef(); }
+		else if (Name == TEXT("position")) { Type = FNiagaraTypeDefinition::GetPositionDef(); }
+		else { return false; }
+		return true;
+	}
+
+	static FString Scope(ENiagaraScriptUsage Usage)
+	{
+		switch (Usage)
+		{
+		case ENiagaraScriptUsage::SystemSpawnScript:
+		case ENiagaraScriptUsage::SystemUpdateScript: return TEXT("System");
+		case ENiagaraScriptUsage::EmitterSpawnScript:
+		case ENiagaraScriptUsage::EmitterUpdateScript: return TEXT("Emitter");
+		case ENiagaraScriptUsage::ParticleSpawnScript:
+		case ENiagaraScriptUsage::ParticleUpdateScript: return TEXT("Particles");
+		default: return FString();
+		}
+	}
+
+	static TSharedPtr<INiagaraEditorTypeUtilities, ESPMode::ThreadSafe> TypeUtilities(const FNiagaraTypeDefinition& Type)
+	{
+		return FModuleManager::LoadModuleChecked<FNiagaraEditorModule>(TEXT("NiagaraEditor")).GetTypeUtilities(Type);
+	}
+
+	static bool ParseDefault(const FNiagaraModuleAuthoringPin& Pin, FString& OutDefault, FNiagaraVariable* OutValue = nullptr)
+	{
+		FNiagaraTypeDefinition Type;
+		if (!ResolveType(Pin.Type, Type)) { return false; }
+		auto Utilities = TypeUtilities(Type);
+		if (!Utilities || !Utilities->CanHandlePinDefaults()) { return false; }
+		FNiagaraVariable Value(Type, *Pin.Variable);
+		Value.AllocateData();
+		Utilities->UpdateVariableWithDefaultValue(Value);
+		if (!Pin.DefaultValue.IsEmpty() && !Utilities->SetValueFromPinDefaultString(Pin.DefaultValue, Value)) { return false; }
+		OutDefault = Utilities->GetPinDefaultStringFromValue(Value);
+		if (OutValue) { *OutValue = Value; }
+		return true;
+	}
+
+	// ChangeID can be regenerated on PostLoad and UI-only edits need not change it.
+	// Compare serialized graph semantics instead, excluding layout and transient compile state.
+	static FString Fingerprint(UNiagaraScript* Script, UNiagaraGraph* Graph)
+	{
+		TArray<FString> Nodes;
+		for (UEdGraphNode* Node : Graph->Nodes)
+		{
+			FString Record = Node->GetClass()->GetPathName() + TEXT("|") + Node->NodeGuid.ToString();
+			Record += FString::FromInt(static_cast<int32>(Node->GetDesiredEnabledState()));
+			if (UNiagaraNodeCustomHlsl* Custom = Cast<UNiagaraNodeCustomHlsl>(Node)) { Record += TEXT("|") + Custom->GetCustomHlsl(); }
+			TArray<FString> Pins;
+			for (UEdGraphPin* Pin : Node->Pins)
+			{
+				if (UNiagaraNodeWithDynamicPins::IsAddPin(Pin)) { continue; }
+				FString PinRecord = Pin->PinName.ToString() + TEXT("|") + FString::FromInt(Pin->Direction) + TEXT("|") +
+					Pin->PinType.PinCategory.ToString() + TEXT("|") + Pin->PinType.PinSubCategory.ToString() + TEXT("|") +
+					GetPathNameSafe(Pin->PinType.PinSubCategoryObject.Get()) + TEXT("|") + Pin->DefaultValue + TEXT("|") +
+					GetPathNameSafe(Pin->DefaultObject) + TEXT("|") + Pin->DefaultTextValue.ToString();
+				TArray<FString> Links;
+				for (UEdGraphPin* Link : Pin->LinkedTo)
+				{
+					Links.Add(Link->GetOwningNode()->NodeGuid.ToString() + TEXT("|") + Link->PinName.ToString() + FString::FromInt(Link->Direction));
+				}
+				Links.Sort();
+				PinRecord += FString::Join(Links, TEXT("|"));
+				Pins.Add(PinRecord);
+			}
+			Pins.Sort();
+			Record += FString::Join(Pins, TEXT("\n"));
+			Nodes.Add(Record);
+		}
+		Nodes.Sort();
+		const FVersionedNiagaraScriptData* Data = Script->GetLatestScriptData();
+		const FString Content = FString::Join(Nodes, TEXT("\n---\n")) + FString::FromInt(Data->ModuleUsageBitmask) + Data->Description.ToString();
+		const FTCHARToUTF8 Utf8(*Content);
+		uint8 Hash[FSHA1::DigestSize];
+		FSHA1::HashBuffer(Utf8.Get(), Utf8.Length(), Hash);
+		return BytesToHex(Hash, UE_ARRAY_COUNT(Hash));
+	}
+
+	static UNiagaraScriptSource* BuildSource(UNiagaraScript* Script, const FNiagaraModuleAuthoringDefinition& Definition, FString& Error)
+	{
+		UNiagaraScriptSource* Source = NewObject<UNiagaraScriptSource>(Script, NAME_None, RF_Transactional);
+		UNiagaraGraph* Graph = NewObject<UNiagaraGraph>(Source, NAME_None, RF_Transactional);
+		Source->NodeGraph = Graph;
+		const UEdGraphSchema_Niagara* Schema = CastChecked<UEdGraphSchema_Niagara>(Graph->GetSchema());
+
+		FGraphNodeCreator<UNiagaraNodeInput> InputCreator(*Graph);
+		UNiagaraNodeInput* MapInput = InputCreator.CreateNode();
+		MapInput->Input = FNiagaraVariable(FNiagaraTypeDefinition::GetParameterMapDef(), TEXT("MapIn"));
+		MapInput->Usage = ENiagaraInputNodeUsage::Parameter;
+		InputCreator.Finalize();
+		MapInput->NodePosX = -600;
+
+		FGraphNodeCreator<UNiagaraNodeOutput> OutputCreator(*Graph);
+		UNiagaraNodeOutput* MapOutput = OutputCreator.CreateNode();
+		MapOutput->SetUsage(ENiagaraScriptUsage::Module);
+		MapOutput->Outputs.Add(FNiagaraVariable(FNiagaraTypeDefinition::GetParameterMapDef(), TEXT("Output")));
+		OutputCreator.Finalize();
+		MapOutput->NodePosX = 650;
+
+		FGraphNodeCreator<UNiagaraNodeParameterMapGet> GetCreator(*Graph);
+		UNiagaraNodeParameterMapGet* Get = GetCreator.CreateNode();
+		GetCreator.Finalize();
+		Get->NodePosX = -350;
+
+		FGraphNodeCreator<UNiagaraNodeParameterMapSet> SetCreator(*Graph);
+		UNiagaraNodeParameterMapSet* Set = SetCreator.CreateNode();
+		SetCreator.Finalize();
+		Set->NodePosX = 350;
+
+		FGraphNodeCreator<UNiagaraNodeCustomHlsl> HlslCreator(*Graph);
+		UNiagaraNodeCustomHlsl* Hlsl = HlslCreator.CreateNode();
+		HlslCreator.Finalize();
+		Hlsl->NodePosY = 150;
+
+		auto Connect = [&](UEdGraphPin* From, UEdGraphPin* To)
+		{
+			return From && To && Schema->TryCreateConnection(From, To);
+		};
+		if (!Connect(MapInput->GetOutputPin(0), Get->GetInputPin(0)) ||
+			!Connect(MapInput->GetOutputPin(0), Set->GetInputPin(0)) ||
+			!Connect(Set->GetOutputPin(0), MapOutput->GetInputPin(0)))
+		{
+			Fail(Error, TEXT("Could not connect the module parameter map."));
+			return nullptr;
+		}
+
+		for (const FNiagaraModuleAuthoringPin& Pin : Definition.Inputs)
+		{
+			FNiagaraTypeDefinition Type;
+			ResolveType(Pin.Type, Type);
+			FNiagaraVariable Variable(Type, *Pin.Variable);
+			FNiagaraVariableMetaData Metadata;
+			Metadata.Description = FText::FromString(Pin.Description);
+			FString Default;
+			ParseDefault(Pin, Default, &Variable);
+			UNiagaraScriptVariable* ScriptVariable = Graph->AddParameter(Variable, Metadata, false, false);
+			ScriptVariable->SetDefaultValueData(Variable.GetData());
+			UEdGraphPin* Value = Get->RequestNewTypedPin(EGPD_Output, Type, *Pin.Variable);
+			UEdGraphPin* Argument = Hlsl->RequestNewTypedPin(EGPD_Input, Type, *Pin.Name);
+			UEdGraphPin* DefaultPin = Value ? Get->GetDefaultPin(Value) : nullptr;
+			if (!DefaultPin || !Argument || Argument->PinName != FName(*Pin.Name) || !Connect(Value, Argument))
+			{
+				Fail(Error, FString::Printf(TEXT("Could not create input '%s'."), *Pin.Name));
+				return nullptr;
+			}
+			Schema->TrySetDefaultValue(*DefaultPin, Default);
+		}
+		for (const FNiagaraModuleAuthoringPin& Pin : Definition.Outputs)
+		{
+			FNiagaraTypeDefinition Type;
+			ResolveType(Pin.Type, Type);
+			UEdGraphPin* Value = Hlsl->RequestNewTypedPin(EGPD_Output, Type, *Pin.Name);
+			UEdGraphPin* Target = Set->RequestNewTypedPin(EGPD_Input, Type, *Pin.Variable);
+			if (!Value || Value->PinName != FName(*Pin.Name) || !Connect(Value, Target))
+			{
+				Fail(Error, FString::Printf(TEXT("Could not create output '%s'."), *Pin.Name));
+				return nullptr;
+			}
+		}
+		Hlsl->SetCustomHlsl(Definition.Hlsl);
+		Graph->MarkGraphRequiresSynchronization(TEXT("Module authoring"));
+		return Source;
+	}
+
+	static void Commit(UNiagaraScript* Script, UNiagaraScriptSource* Source, const FNiagaraModuleAuthoringDefinition& Definition)
+	{
+		Script->Modify();
+		Script->SetLatestSource(Source);
+		FVersionedNiagaraScriptData* Data = Script->GetLatestScriptData();
+		Data->ModuleUsageBitmask = 0;
+		for (ENiagaraScriptUsage Usage : Definition.AllowedUsages) { Data->ModuleUsageBitmask |= (1 << static_cast<uint8>(Usage)); }
+		Data->Description = FText::FromString(Definition.Description);
+		Data->Category = FText::FromString(TEXT("AutoFlow"));
+		Data->LibraryVisibility = ENiagaraScriptLibraryVisibility::Library;
+		FString Json;
+		FJsonObjectConverter::UStructToJsonObjectString(Definition, Json);
+		// Bind metadata to the source graph so transaction undo restores the matching definition.
+		Script->GetPackage()->GetMetaData().SetValue(Source->NodeGraph, DefinitionKey, *Json);
+		Script->MarkPackageDirty();
+		Script->PostEditChange();
+		Script->GetPackage()->GetMetaData().SetValue(Source->NodeGraph, GraphIdKey, *Fingerprint(Script, Source->NodeGraph));
+	}
+}
+
+bool FNiagaraScriptAuthoringUtilities::ValidateDefinition(const FNiagaraModuleAuthoringDefinition& Definition, FString& OutError)
+{
+	using namespace NiagaraScriptAuthoring;
+	OutError.Reset();
+	if (!IsInGameThread()) { return Fail(OutError, TEXT("Script authoring must run on the game thread.")); }
+	if (Definition.Hlsl.TrimStartAndEnd().IsEmpty() || Definition.Hlsl.Len() > 262144 || Definition.Inputs.Num() > 64 || Definition.Outputs.Num() > 64)
+	{
+		return Fail(OutError, TEXT("Provide nonempty HLSL (at most 256K characters), at most 64 inputs and at most 64 outputs."));
+	}
+	if (Definition.Outputs.IsEmpty() || Definition.AllowedUsages.IsEmpty()) { return Fail(OutError, TEXT("At least one output and one allowed usage are required.")); }
+	const FString WritableScope = Scope(Definition.AllowedUsages[0]);
+	for (ENiagaraScriptUsage Usage : Definition.AllowedUsages)
+	{
+		if (WritableScope.IsEmpty() || Scope(Usage) != WritableScope) { return Fail(OutError, TEXT("Use standard Spawn/Update usages sharing one scope: System, Emitter or Particles.")); }
+	}
+	TSet<FName> PinNames;
+	TMap<FName, FString> VariableTypes;
+	for (int32 Direction = 0; Direction < 2; ++Direction)
+	{
+		TSet<FName> Variables;
+		const TArray<FNiagaraModuleAuthoringPin>& Pins = Direction == 0 ? Definition.Inputs : Definition.Outputs;
+		for (const FNiagaraModuleAuthoringPin& Pin : Pins)
+		{
+			FNiagaraTypeDefinition Type;
+			if (!Identifier(Pin.Name) || Pin.Name == TEXT("Add") || PinNames.Contains(FName(*Pin.Name)) || !ResolveType(Pin.Type, Type))
+			{
+				return Fail(OutError, FString::Printf(TEXT("Invalid/duplicate HLSL pin '%s' or unsupported type '%s'."), *Pin.Name, *Pin.Type));
+			}
+			PinNames.Add(FName(*Pin.Name));
+			TArray<FString> Parts;
+			Pin.Variable.ParseIntoArray(Parts, TEXT("."), false);
+			if (Parts.Num() < 2 || Parts.ContainsByPredicate([](const FString& Part) { return !Identifier(Part); }) || Variables.Contains(FName(*Pin.Variable)))
+			{
+				return Fail(OutError, FString::Printf(TEXT("Invalid/duplicate variable '%s'."), *Pin.Variable));
+			}
+			Variables.Add(FName(*Pin.Variable));
+			if (const FString* ExistingType = VariableTypes.Find(FName(*Pin.Variable)); ExistingType && *ExistingType != Pin.Type)
+			{
+				return Fail(OutError, FString::Printf(TEXT("Variable '%s' has inconsistent types."), *Pin.Variable));
+			}
+			VariableTypes.Add(FName(*Pin.Variable), Pin.Type);
+			const FString& Namespace = Parts[0];
+			if (Direction == 1)
+			{
+				if (Namespace != WritableScope || !Pin.DefaultValue.IsEmpty()) { return Fail(OutError, TEXT("Outputs must write the allowed usage's scope and cannot have defaults.")); }
+			}
+			else
+			{
+				const bool bReadable = Namespace == TEXT("Module") || Namespace == TEXT("User") || Namespace == TEXT("Engine") || Namespace == TEXT("System") ||
+					(Namespace == TEXT("Emitter") && WritableScope != TEXT("System")) || (Namespace == TEXT("Particles") && WritableScope == TEXT("Particles"));
+				FString Default;
+				if (!bReadable || !ParseDefault(Pin, Default)) { return Fail(OutError, FString::Printf(TEXT("Input '%s' has an unreadable namespace or invalid Niagara pin default."), *Pin.Name)); }
+			}
+		}
+	}
+	return true;
+}
+
+UNiagaraScript* FNiagaraScriptAuthoringUtilities::CreateModuleScript(UObject* Outer, FName Name, const FNiagaraModuleAuthoringDefinition& Definition, FString& OutError)
+{
+	if (!ValidateDefinition(Definition, OutError)) { return nullptr; }
+	if (!Cast<UPackage>(Outer) || Name.IsNone() || StaticFindObjectFast(UObject::StaticClass(), Outer, Name))
+	{
+		OutError = TEXT("Outer must be a package and the asset name must be unused.");
+		return nullptr;
+	}
+	const FScopedTransaction Transaction(NSLOCTEXT("NiagaraScriptAuthoring", "Create", "Create HLSL module script"));
+	UNiagaraScript* Script = NewObject<UNiagaraScript>(Outer, Name, RF_Public | RF_Standalone | RF_Transactional);
+	Script->Usage = ENiagaraScriptUsage::Module;
+	UNiagaraScriptSource* Source = NiagaraScriptAuthoring::BuildSource(Script, Definition, OutError);
+	if (!Source)
+	{
+		Script->ClearFlags(RF_Public | RF_Standalone);
+		Script->MarkAsGarbage();
+		return nullptr;
+	}
+	NiagaraScriptAuthoring::Commit(Script, Source, Definition);
+	return Script;
+}
+
+bool FNiagaraScriptAuthoringUtilities::GetModuleDefinition(UNiagaraScript* Script, FNiagaraModuleAuthoringDefinition& OutDefinition, FString& OutError)
+{
+	using namespace NiagaraScriptAuthoring;
+	OutError.Reset();
+	if (!IsInGameThread() || !Script || Script->Usage != ENiagaraScriptUsage::Module || Script->IsVersioningEnabled()) { return Fail(OutError, TEXT("Expected an unversioned module script on the game thread.")); }
+	UNiagaraScriptSource* Source = Cast<UNiagaraScriptSource>(Script->GetLatestSource());
+	if (!Source || !Source->NodeGraph) { return Fail(OutError, TEXT("Module has no editable graph.")); }
+	FMetaData& Metadata = Script->GetPackage()->GetMetaData();
+	const FString SavedFingerprint = Metadata.GetValue(Source->NodeGraph, GraphIdKey);
+	const FString CurrentFingerprint = Fingerprint(Script, Source->NodeGraph);
+	const FString Json = Metadata.GetValue(Source->NodeGraph, DefinitionKey);
+	if (SavedFingerprint != CurrentFingerprint || !FJsonObjectConverter::JsonObjectStringToUStruct(Json, &OutDefinition, 0, 0))
+	{
+		return Fail(OutError, FString::Printf(TEXT("Module is unmanaged or was edited outside the authoring bridge. Refusing to reconstruct its graph. Saved fingerprint=%s; current=%s; definition chars=%d."), *SavedFingerprint, *CurrentFingerprint, Json.Len()));
+	}
+	return true;
+}
+
+bool FNiagaraScriptAuthoringUtilities::UpdateModuleDefinition(UNiagaraScript* Script, const FNiagaraModuleAuthoringDefinition& Definition, FString& OutError)
+{
+	FNiagaraModuleAuthoringDefinition Previous;
+	if (!GetModuleDefinition(Script, Previous, OutError) || !ValidateDefinition(Definition, OutError)) { return false; }
+	FScopedTransaction Transaction(NSLOCTEXT("NiagaraScriptAuthoring", "Update", "Update HLSL module script"));
+	UNiagaraScriptSource* Candidate = NiagaraScriptAuthoring::BuildSource(Script, Definition, OutError);
+	if (!Candidate) { Transaction.Cancel(); return false; }
+	NiagaraScriptAuthoring::Commit(Script, Candidate, Definition);
+	return true;
+}
